[TEMPLATE]
# tchat — example environment configuration
# Copy this file to `.env` and adjust as needed:  cp .env.example .env

# HTTP/WebSocket port the server listens on.
# Default: 3000
PORT=3000

# SQLite database file location.
# Default: ./database.db
DATABASE_PATH=./database.db

# GIPHY API key — required only for GIF search.
# Get one at https://developers.giphy.com/
# Leave empty to disable GIF search.
GIPHY_API_KEY=

# How long (ms) a fully-empty room is kept before it is deleted.
# Default: 86400000 (24 hours)
EMPTY_ROOM_TTL_MS=86400000

# How often (ms) the background job reaps empty rooms and expired sessions.
# Default: 300000 (5 minutes)
CLEANUP_INTERVAL_MS=300000

# Shared secret for POST /api/promote (operator-only admin promotion).
# Set this on the host (Cloud Run env var, etc.). When unset, the endpoint
# always rejects. Usage:
#   curl -X POST https://your-app.run.app/api/promote \
#     -H "x-admin-secret: $ADMIN_SECRET" \
#     -H "Content-Type: application/json" \
#     -d '{"username":"bob"}'
# Omit username or set isAdmin:false to demote.
ADMIN_SECRET=

# Set to "production" to send session cookies with the Secure flag.
# Leave unset (or "development") for local HTTP development.
NODE_ENV=development

# --- Split hosting (frontend and backend on different origins) ---

# Comma-separated list of separately-hosted frontend origins
# (e.g. https://yourapp.appwrite.global,https://staging.appwrite.global).
# Setting any enables CORS for those origins and makes the session cookie
# SameSite=None so cross-origin requests carry it. Leave empty for same-origin.
# Set to `*` to allow any origin. FRONTEND_ORIGIN (single value) is still
# accepted as a legacy fallback.
#
# Note: SameSite=None requires HTTPS. Over plain HTTP (localhost dev) the
# server automatically falls back to SameSite=Lax so logins still work.
FRONTEND_ORIGINS=

# Vite build-time variables for the FRONTEND. Set these before `npm run build`
# when the SPA is hosted separately (e.g. on Appwrite).
# Absolute REST API base (including /api): e.g. https://api.onrender.com/api
VITE_API_URL=
# Absolute WebSocket URL (optional; derived from VITE_API_URL if omitted).
VITE_WS_URL=